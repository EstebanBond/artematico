# Database
POSTGRES_PASSWORD=localdevtest

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Acceso por PIN, uno por hijo (nunca cuenta individual, ver CLAUDE.md).
# STUDENTS: slug:pin:Nombre separados por coma, uno por estudiante.
# COOKIE_SECRET: cadena aleatoria larga para firmar la cookie de sesión (ej. `openssl rand -hex 32`).
STUDENTS=jorge:change-me:Jorge
COOKIE_SECRET=change-me-too

# Recordatorio diario por Web Push. Generar una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT debe ser un mailto: o https: que identifique al remitente
# ante los servicios push de Apple/Google/Mozilla.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Solo necesarias en el droplet (rebanada 12) — localmente tienen default y se
# ignoran porque docker-compose.override.yml compila de fuente. Ver docs/DEPLOY.md.
# GHCR_OWNER=tu-usuario-o-org-de-github
# TALLER_VERSION=v1.0.0
